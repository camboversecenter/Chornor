    "@scure/bip39": "^1.6.0",
    "@solana/kit": "^2.3.0",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hash-wasm": "^4.12.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "9",
    "recharts": "^3.8.1",
    "sweetalert2": "11",
    "thirdweb": "^5.115.3",
    "vite": "^6.2.3"
