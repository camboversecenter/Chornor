{
  "name": "chornor",
  "private": true,
  "version": "0.2.0",
  "description": "Chornor (ចំណូលចំណាយ) is a free, open-source, dual-currency personal finance app for Cambodia: budgeting, lending, savings, crypto, and an AI assistant.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "Tomorrow Rich Together",
  "homepage": "https://chornors.camboverse.world",
  "repository": {
    "type": "git",
    "url": "https://github.com/camboversecenter/Chornor.git"
  },
  "bugs": {
    "url": "https://github.com/camboversecenter/Chornor/issues"
  },
  "keywords": [
    "cambodia",
    "personal-finance",
    "budgeting",
    "khmer",
    "riel",
    "fintech",
    "react",
    "supabase",
    "open-source"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
