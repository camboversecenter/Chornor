# === Server-side only (never exposed to the browser) ===

# GEMINI_API_KEY: Required for Google Gemini API calls.
# Used by the /api/gemini proxy in server.ts. Keep this server-side only,
# do NOT prefix it with VITE_ (that would ship it to the client bundle).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://chornors.camboverse.world"

# === Client-side (VITE_ prefixed values are bundled into the browser) ===

# Supabase project. The anon key is a publishable client key; security relies
# on Row Level Security being enabled on every table.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional CoinGecko demo API key. Leave empty to use the keyless public
# endpoint. Any value here is visible in the client bundle, so use a
# rate-limited demo key, not a paid/secret one.
VITE_COINGECKO_API_KEY=""

# Optional Moralis API key for wallet balances (see wallet/config.ts).
VITE_MORALIS_API_KEY=""
